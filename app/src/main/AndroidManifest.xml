<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Playback. Without it the system stops a sink the moment it leaves the foreground. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Discovery. NsdManager answers out of a platform daemon that this app's multicast filter
         does not apply to, so the lock may be unnecessary - held anyway because whether these
         vendor builds behave like the platform one is not something to learn from a failed run. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Calibration. WifiLock.acquire is guarded by this one, and without it the lock fails
         silently - which would make a run read as evidence that power save does not matter when
         the arm under test never ran. Normal permission; nothing is prompted for. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Reconnection. Section 11.2 asks for a network change to be detected rather than waited
         out; without this the only thing that notices a WiFi switch is a socket timeout. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Pairing. The camera is used for one thing and held for as long as it takes to read one
         code off another handset screen; nothing here records or keeps an image. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <queries>
        <package android:name="com.netease.cloudmusic" />
        <package android:name="com.tencent.qqmusic" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- Still first, and still written with a closing tag: LauncherIntentDeliveryTest reads
             this file and checks the first activity block, which is how it holds MainActivity to
             singleTask. What it lost is only the launcher filter below - ADB starts it by explicit
             component, which is the only way anything has ever started it. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"></activity>
        <!-- The product's front door: the one screen someone who never attaches a cable sees. -->
        <activity
            android:name="com.soundmesh.product.HomeActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Exported so it can be started by name: the self-measurement's first job is to agree
             with the PC-measured constant it replaces, and that comparison is driven over ADB. -->
        <activity
            android:name="com.soundmesh.product.CalibrateActivity"
            android:exported="true"
            android:launchMode="singleTask" />
        <!-- Exported for the same reason as the one above: the first job of this measurement is to
             agree with the four harness runs it replaces, and that comparison is driven over ADB. -->
        <activity
            android:name="com.soundmesh.product.PeerCalibrateActivity"
            android:exported="true"
            android:launchMode="singleTask" />
        <activity
            android:name=".sync.SyncActivity"
            android:exported="true"
            android:launchMode="singleTask" />
        <activity
            android:name=".sync.ScanActivity"
            android:exported="true"
            android:launchMode="singleTask" />
        <activity
            android:name=".sync.ShowCodeActivity"
            android:exported="true"
            android:launchMode="singleTask" />
        <service
            android:name=".CaptureForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <service
            android:name=".sync.SyncProjectionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <activity
            android:name="com.soundmesh.session.SessionActivity"
            android:exported="true"
            android:launchMode="singleTask" />
        <service
            android:name="com.soundmesh.session.SessionService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
